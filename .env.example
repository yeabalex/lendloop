# ============================================================================
# LendLoop Environment Variables
# Copy this file to `.env.local` for Next.js, and configure Convex env vars
# in the Convex Dashboard (or via `npx convex env set KEY VALUE`).
# ============================================================================

# --- Convex (Frontend & Next.js) ---
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# --- Clerk Authentication (Next.js) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# --- Convex Backend Environment Variables (set via `npx convex env set`) ---
# Clerk JWT Issuer Domain (from Clerk Dashboard -> JWT Templates -> "convex")
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev

# Optional: comma-separated emails automatically granted "admin" role on first sign-in
INITIAL_ADMIN_EMAILS=admin@lendloop.local

# --- n8n Webhook Integration (set in both Convex env and n8n credentials) ---
# Outbound webhook URL in n8n triggered when a borrow request is created or changes status
N8N_REQUEST_WEBHOOK_URL=http://localhost:5678/webhook/lendloop-request-events

# Shared HMAC-SHA256 secret used to sign payloads (Convex -> n8n) and verify requests (n8n -> Convex)
N8N_WEBHOOK_SECRET=replace-with-a-32-byte-hex-hmac-secret

